<?xml version="1.0" encoding="utf-8"?>
<!-- First paint before Glance draws the real widget (design 06G.1, Loading). Grey blocks on the card colour. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="12dp"
    android:background="@drawable/widget_loading_bg">
    <View android:layout_width="60dp" android:layout_height="10dp" android:background="@drawable/widget_loading_block" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="horizontal">
        <View android:layout_width="24dp" android:layout_height="44dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_loading_block" />
        <View android:layout_width="24dp" android:layout_height="44dp" android:background="@drawable/widget_loading_block" />
    </LinearLayout>
    <View android:layout_width="90dp" android:layout_height="10dp" android:background="@drawable/widget_loading_block" />
</LinearLayout>
